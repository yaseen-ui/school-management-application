# Required environment variables for the school management application

# Prisma / database connection
#DATABASE_URL=
# Local dev alternative:
DATABASE_URL=postgresql://super_admin:Shabbu@05@localhost:5432/school_management?schema=public

# JWT for auth signing
JWT_SECRET=replace_with_your_jwt_secret

# Logging level
LOG_LEVEL=info

# Local server port (if used by backend API server)
PORT=5001

# Google Cloud Storage settings
GOOGLE_CLOUD_PROJECT_ID=compact-gadget-449609-h1
GCS_BUCKET_NAME=school-management-uploads
GCS_SERVICE_ACCOUNT_PATH=./config/google-service-key.json

# Production (Vercel): Base64-encode your google-service-key.json and paste here
# Generate with: base64 -i config/google-service-key.json
#GCS_SERVICE_ACCOUNT_JSON=

# Twilio SMS settings
TWILIO_ACCOUNT_SID=replace_with_your_twilio_account_sid
TWILIO_AUTH_TOKEN=replace_with_your_twilio_auth_token
TWILIO_PHONE_NUMBER=+18782255926

# DeepSeek AI configuration (for ZAI Query Bot)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Next.js public env vars used by the frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:5001/api
# NEXT_PUBLIC_HOST_TYPE=tenant
NEXT_PUBLIC_HOST_TYPE=company

# Communication module — channel enablement flags
COMM_IN_APP_ENABLED=true
COMM_EMAIL_ENABLED=false
COMM_SMS_ENABLED=false
COMM_PUSH_ENABLED=false

# WhatsApp Cloud API (Meta) — see docs/whatsapp-integration-handover.md
# Master switch for live Graph API sends (requires approved templates + credentials)
COMM_WHATSAPP_ENABLED=false
# When true (or when credentials missing), payloads are logged and not sent to Meta
COMM_WHATSAPP_DRY_RUN=true
COMM_WHATSAPP_PHONE_NUMBER_ID=
COMM_WHATSAPP_API_KEY=
COMM_WHATSAPP_FROM_NUMBER=
# Webhook verify token (Meta → /api/webhooks/whatsapp)
COMM_WHATSAPP_WEBHOOK_VERIFY_TOKEN=replace_with_random_verify_token
# Optional: verify X-Hub-Signature-256 (Meta App Secret)
COMM_WHATSAPP_APP_SECRET=
# Graph API version and default country for phone normalization (India = 91)
COMM_WHATSAPP_API_VERSION=v21.0
COMM_WHATSAPP_TEMPLATE_LANG=en
COMM_DEFAULT_COUNTRY_CODE=91
# Concurrent provider dispatches per send (default 5)
COMM_DISPATCH_CONCURRENCY=5
